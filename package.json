{
  "name": "lingo-family",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "vite --mode ai",
    "build": "tsc -b && vite build",
    "preview": "tsc -b && vite build --mode preview && vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "bench:images": "node benchmarks/run.mjs benchmarks/imageBenchmark.ts",
    "migrate:content": "node benchmarks/run.mjs scripts/migrate/run.ts",
    "assign-creator": "node benchmarks/run.mjs scripts/assignCreator/run.ts",
    "scan-llm-content": "node benchmarks/run.mjs scripts/scanLlmContent/run.ts",
    "topik-import": "node benchmarks/run.mjs scripts/topikImport/run.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "ts-fsrs": "^5.4.2",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "jszip": "^3.10.2",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
