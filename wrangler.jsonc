{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingo-family",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // Unknown paths return index.html so React Router can handle them.
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker, never to static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingo-family",
      // Placeholder: local dev does not need a real id. Replace with the id from
      // `wrangler d1 create lingo-family` before the first remote deploy (M2).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  // Workers AI (FLUX image drawing, M1.8). Always runs on Cloudflare, also in local dev,
  // so `npm run dev` and the image benchmark need `npx wrangler login` once.
  // `remote: true` states this explicitly (and silences wrangler's warning).
  "ai": { "binding": "AI", "remote": true },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lingo-family-media"
    }
  ],
  // Optional, non-secret settings. TTS voices default to ko-KR-SunHiNeural and en-US-JennyNeural
  // (worker/services/tts.ts). To override, uncomment and edit, e.g.:
  // "vars": { "TTS_VOICE_KO": "ko-KR-SunHiNeural", "TTS_VOICE_EN": "en-US-JennyNeural" },
  // Secrets (AZURE_SPEECH_KEY, LLM_API_KEY, ...) live in .dev.vars / `wrangler secret`, never here.
}
