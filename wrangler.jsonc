{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // https://lingo.ai4life.workers.dev is the only entrance. Preview URLs are off, so no
  // second hostname exists that Cloudflare Access would have to protect.
  // Placement: Cloudflare's Hong Kong data center (HKG, where Korean users enter) cannot call the
  // Gemini API ("User location is not supported"). Run the Worker in Seoul instead. If the
  // region is not accepted, use { "mode": "smart" } or { "mode": "targeted", "hostname":
  // "generativelanguage.googleapis.com" }.
  "placement": { "mode": "targeted", "region": "gcp:asia-northeast3" },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // `not_found_handling` is deliberately NOT "single-page-application" (M7.4). That setting
    // answered *every* unmatched path with index.html, including a missing /assets/x.css — so the
    // service worker was handed an HTML page where a stylesheet belonged, called the response bad,
    // and failed to install, leaving a phone stuck on the previous build with no way to recover.
    // With no setting, an unmatched path falls through to the Worker, which answers a real 404 for
    // anything that looks like a file and index.html for an app route (see `spaFallback`).
    "binding": "ASSETS",
    // /api/* always goes to the Worker, never to static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingo-family",
      // Production database (created in M2.1). Local dev (Miniflare) ignores the id; the migrate
      // scripts say explicitly --local or --remote.
      "database_id": "10da2bc0-1ba1-4ae2-80be-df43cd5b1931",
      "migrations_dir": "db/migrations"
    }
  ],
  // Workers AI (FLUX image drawing, M1.8). Always runs on Cloudflare, also in local dev,
  // so `npm run dev` and the image benchmark need `npx wrangler login` once.
  // `remote: true` states this explicitly (and silences wrangler's warning).
  "ai": { "binding": "AI", "remote": true },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lingo-family-media"
    }
  ],
  // Non-secret settings. Every /api request must carry a Cloudflare Access JWT for this team
  // and application (worker/middleware/access.ts); if either value is missing the API answers 401.
  // ACCESS_AUD = "Application Audience (AUD) Tag" of the Access application (public, not a secret);
  // an empty value keeps the API closed (fail-closed).
  // TTS voices default to ko-KR-SunHiNeural and en-US-JennyNeural (worker/services/tts.ts); to
  // override add TTS_VOICE_KO / TTS_VOICE_EN here.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ai4life.cloudflareaccess.com",
    "ACCESS_AUD": "902190725cc1087918e2449010517ba6f33a74aaa771d89847971cae1a855f60"
  },
  // Secrets live in .dev.vars / `wrangler secret put`, never here: AZURE_SPEECH_KEY,
  // AZURE_SPEECH_REGION, LLM_*, and ALLOWED_EMAILS (family emails, comma separated).
  // Never set DEV_AUTH_BYPASS or DEV_TIME_TRAVEL in production (they only work on localhost anyway).
}
