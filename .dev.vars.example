# Copy to .dev.vars (git-ignored) and fill in real values for local development.
# In production set them with `npx wrangler secret put <NAME>`.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Optional: tried once when LLM_MODEL is still busy (429/500/503) after 3 retries.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=..
AZURE_SPEECH_KEY=..
AZURE_SPEECH_REGION=koreacentral

CLOUDFLARE_SUBDOMAIN=ai4life

# Local only: lets the review screen fake "today" (X-Dev-Now header). Never set in production.
DEV_TIME_TRAVEL=1
